{
  "name": "@frontier-labs/ui-kit",
  "version": "3.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "description": "A zero-dependency React component library with built-in theming, motion, and accessibility.",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./form": {
      "import": {
        "types": "./dist/esm/form.d.ts",
        "default": "./dist/esm/form.js"
      }
    },
    "./theme": {
      "import": {
        "types": "./dist/esm/theme.d.ts",
        "default": "./dist/esm/theme.js"
      }
    },
    "./lite": {
      "import": {
        "types": "./dist/esm/lite.d.ts",
        "default": "./dist/esm/lite.js"
      }
    },
    "./premium": {
      "import": {
        "types": "./dist/esm/premium.d.ts",
        "default": "./dist/esm/premium.js"
      }
    },
    "./lite/styles.css": "./dist/css/lite.css",
    "./css/theme.css": "./dist/css/theme.css",
    "./css/all.css": "./dist/css/all.css",
    "./css/components/*": "./dist/css/components/*",
    "./rsc": {
      "import": {
        "types": "./dist/esm/rsc.d.ts",
        "default": "./dist/esm/rsc.js"
      }
    },
    "./web-components": {
      "import": {
        "types": "./dist/esm/web-components.d.ts",
        "default": "./dist/esm/web-components.js"
      }
    },
    "./ai": {
      "import": {
        "types": "./dist/esm/ai.d.ts",
        "default": "./dist/esm/ai.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsup --config tsup.cli.config.ts && tsup --config tsup.mcp.config.ts && node scripts/extract-css.js && npx tsx scripts/extract-component-meta.ts && npm run build:registry && npm run sync:registry",
    "build:meta": "npx tsx scripts/extract-component-meta.ts",
    "verify:svelte": "npm run build:svelte && npm run test:svelte && npm run check:svelte && npm run test:svelte-no-react && npm run test:svelte-parity && npm run test:svelte-csp && npm run test:svelte-size && npm run test:contract-fresh && npm run test:refs-fresh && npm run test:vendor-fresh && npm run test:svelte-css-fresh && npm run test:unitless-fresh",
    "build:unitless": "node scripts/extract-react-unitless.js",
    "test:unitless-fresh": "node scripts/extract-react-unitless.js --check",
    "build:svelte": "npm run build:unitless && npm run vendor:core && npm run build:svelte-css && npm -w @frontier-labs/ui-kit-svelte run build",
    "test:svelte": "npm -w @frontier-labs/ui-kit-svelte run test",
    "check:svelte": "npm -w @frontier-labs/ui-kit-svelte run check",
    "test:svelte-no-react": "node scripts/check-svelte-no-react.js",
    "test:svelte-parity": "node scripts/check-svelte-parity.js",
    "test:svelte-csp": "node scripts/check-svelte-csp.js",
    "test:svelte-size": "node scripts/check-svelte-size.js",
    "build:svelte-css": "node scripts/build-svelte-css.js",
    "test:svelte-css-fresh": "node scripts/build-svelte-css.js --check",
    "vendor:core": "node scripts/vendor-core.js",
    "test:vendor-fresh": "node scripts/vendor-core.js --check",
    "build:contract": "npx tsx scripts/generate-contract-fixtures.tsx",
    "test:contract-fresh": "npx tsx scripts/generate-contract-fixtures.tsx --check",
    "build:refs": "vitest run --config scripts/ref-fixtures.vitest.config.ts",
    "test:refs-fresh": "vitest run --config scripts/ref-fixtures.vitest.config.ts --mode check",
    "build:registry": "node dist/mcp/scripts/build-registry.js",
    "sync:registry": "node scripts/sync-worker-registry.js",
    "build:mcp": "tsup --config tsup.mcp.config.ts && npm run build:registry",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "vitest run src/__tests__/core/a11y",
    "test:bundle-size": "node scripts/check-bundle-size.js",
    "test:counts": "node scripts/check-counts.js",
    "changelog": "node scripts/generate-changelog.js",
    "build:report": "node scripts/generate-bundle-report.js",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build -o storybook-static",
    "test:visual": "playwright test",
    "version": "node scripts/sync-versions.js && git add jsr.json",
    "postversion": "git push && git push origin v$npm_package_version"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.1",
    "@storybook/addon-a11y": "^10.3.0",
    "@storybook/react": "^10.3.0",
    "@storybook/react-vite": "^10.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.0.0",
    "playwright": "^1.58.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "storybook": "^10.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Frontier-Labs-India/ui-kit.git"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "components",
    "ui-kit",
    "design-system",
    "typescript",
    "zero-dependency"
  ],
  "sideEffects": false,
  "bin": {
    "ui-kit": "dist/cli/index.js",
    "ui-kit-mcp": "dist/mcp/index.js"
  },
  "optionalDependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "zod": "^4.3.6"
  }
}
