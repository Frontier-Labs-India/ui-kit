{
  "name": "@frontier-labs/ui-kit-svelte",
  "version": "0.1.0",
  "description": "Svelte 5 components sharing the @frontier-labs/ui-kit design system",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Frontier-Labs-India/ui-kit.git",
    "directory": "packages/svelte"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./css": "./dist/styles/ui-kit-svelte.css",
    "./theme": "./dist/styles/theme.css"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "svelte": "^5"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@testing-library/svelte": "^5.2.0",
    "@testing-library/user-event": "^14.5.2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.7.6"
  },
  "scripts": {
    "test": "vitest run",
    "build": "svelte-package -i src -o dist",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ]
}
